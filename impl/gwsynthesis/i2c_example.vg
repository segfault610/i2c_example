    .O(clk_d),
    .I(clk) 
);
  IBUF rst_n_ibuf (
    .O(rst_n_d),
    .I(rst_n) 
);
  IOBUF sda_iobuf (
    .O(sda_in),
    .IO(sda),
    .I(sda_out),
    .OEN(sda_6) 
);
  OBUF scl_obuf (
    .O(scl),
    .I(scl_d) 
);
  OBUF led_0_obuf (
    .O(led[0]),
