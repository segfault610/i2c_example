module top (
  clk,
  rst_n,
  sda,
  scl,
  led
)
;
input clk;
input rst_n;
inout sda;
output scl;
output [5:0] led;
wire clk_d;
wire rst_n_d;
wire sda_in;
wire led_d_0_9;
wire led_d_3_4;
wire led_d_2_4;
wire led_d_1_4;
wire led_d_4_4;
wire led_d_5_4;
